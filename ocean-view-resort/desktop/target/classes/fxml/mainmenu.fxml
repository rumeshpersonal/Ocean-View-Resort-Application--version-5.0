<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.oceanview.desktop.controller.MainMenuController">
  <center>
    <VBox spacing="20" style="-fx-padding: 40;">
      <Label text="Main Menu" style="-fx-font-size: 24; -fx-font-weight: bold;"/>
      <Label text="Select an operation below:" style="-fx-font-size: 14;"/>
      
      <Separator/>
      
      <Button text="1. Create New Reservation" onAction="#handleCreateReservation" 
              style="-fx-padding: 15; -fx-font-size: 14; -fx-min-width: 300;"/>
      <Button text="2. View Reservation Details" onAction="#handleViewReservation" 
              style="-fx-padding: 15; -fx-font-size: 14; -fx-min-width: 300;"/>
      <Button text="3. Generate Bill" onAction="#handleGenerateBill" 
              style="-fx-padding: 15; -fx-font-size: 14; -fx-min-width: 300;"/>
     <Button text="4. View Help &amp; Usage Guide" onAction="#handleHelp"
        style="-fx-padding: 15; -fx-font-size: 14; -fx-min-width: 300;"/>
      
      <Separator/>
      
      <HBox spacing="10">
        <Button text="Logout" onAction="#handleLogout" style="-fx-padding: 10; -fx-font-size: 14;"/>
        <Button text="Exit" onAction="#handleExit" style="-fx-padding: 10; -fx-font-size: 14;"/>
      </HBox>
    </VBox>
  </center>
</BorderPane>
