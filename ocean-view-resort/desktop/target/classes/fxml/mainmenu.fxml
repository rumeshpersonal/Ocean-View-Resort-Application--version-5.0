<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.oceanview.desktop.controller.MainMenuController"
            stylesheets="@../styles.css">
  
  <top>
    <VBox styleClass="header-pane" alignment="CENTER">
      <Label text="Ocean View Resort" styleClass="header-title"/>
      <Label text="Reception Management" styleClass="header-subtitle"/>
    </VBox>
  </top>
  
  <center>
    <StackPane>
      <VBox styleClass="container-main" alignment="TOP_CENTER" spacing="25" maxWidth="500">
        <VBox.margin>
          <Insets top="30"/>
        </VBox.margin>
        
        <Label text="Main Menu" styleClass="title-section"/>
        <Label text="Select an operation below:" styleClass="title-secondary"/>
        <Separator/>
        
        <VBox spacing="12" alignment="CENTER">
          <Button text="Create New Reservation" onAction="#handleCreateReservation" 
                  styleClass="button-primary" prefWidth="400" prefHeight="45"/>
          <Button text="View Reservation Details" onAction="#handleViewReservation" 
                  styleClass="button-primary" prefWidth="400" prefHeight="45"/>
          <Button text="Generate Bill" onAction="#handleGenerateBill" 
                  styleClass="button-primary" prefWidth="400" prefHeight="45"/>
          <Button text="View Help &amp; Usage Guide" onAction="#handleHelp"
                  styleClass="button-primary" prefWidth="400" prefHeight="45"/>
        </VBox>
        
        <Separator/>
        
        <HBox spacing="15" alignment="CENTER">
          <Button text="Logout" onAction="#handleLogout" styleClass="button-secondary" minWidth="120"/>
          <Button text="Exit" onAction="#handleExit" styleClass="button-danger" minWidth="120"/>
        </HBox>
      </VBox>
    </StackPane>
  </center>
</BorderPane>
