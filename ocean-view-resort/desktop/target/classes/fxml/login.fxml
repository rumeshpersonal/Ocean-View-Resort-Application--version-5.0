<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.oceanview.desktop.controller.LoginController"
            stylesheets="@../styles.css">
  
  <top>
    <VBox styleClass="header-pane" alignment="CENTER">
      <Label text="Ocean View Resort" styleClass="header-title"/>
      <Label text="Room Reservation System" styleClass="header-subtitle"/>
    </VBox>
  </top>
  
  <center>
    <StackPane>
      <VBox styleClass="container-form" alignment="TOP_CENTER" spacing="20" maxWidth="450">
        <VBox.margin>
          <Insets top="40"/>
        </VBox.margin>
        
        <Label text="Guest Login" styleClass="title-section"/>
        <Separator/>
        
        <VBox spacing="15">
          <HBox spacing="15" alignment="CENTER_LEFT">
            <Label text="Username:" styleClass="label-form" minWidth="120"/>
            <TextField fx:id="usernameField" styleClass="text-field" prefWidth="250"/>
          </HBox>
          
          <HBox spacing="15" alignment="CENTER_LEFT">
            <Label text="Password:" styleClass="label-form" minWidth="120"/>
            <PasswordField fx:id="passwordField" styleClass="password-field" prefWidth="250"/>
          </HBox>
        </VBox>
        
        <Label fx:id="errorLabel" styleClass="message-error" wrapText="true"/>
        
        <Separator/>
        
        <HBox spacing="15" alignment="CENTER">
          <Button text="Login" onAction="#handleLogin" styleClass="button-primary"/>
          <Button text="Exit" onAction="#handleExit" styleClass="button-danger"/>
        </HBox>
      </VBox>
    </StackPane>
  </center>
</BorderPane>
