<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.oceanview.desktop.controller.CreateReservationController">
  <center>
    <VBox spacing="15" style="-fx-padding: 25;">
      <Label text="Create New Reservation" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
      
      <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Guest Name:" minWidth="120"/>
        <TextField fx:id="guestNameField" prefWidth="250"/>
      </HBox>
      
      <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Address:" minWidth="120"/>
        <TextField fx:id="addressField" prefWidth="250"/>
      </HBox>
      
      <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Contact:" minWidth="120"/>
        <TextField fx:id="contactField" prefWidth="250" promptText="0771234567 or +94771234567"/>
      </HBox>
      
      <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Room Type:" minWidth="120"/>
        <ComboBox fx:id="roomTypeCombo" prefWidth="250"/>
      </HBox>
      
      <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Check-in (YYYY-MM-DD):" minWidth="120"/>
        <TextField fx:id="checkInField" prefWidth="250"/>
      </HBox>
      
      <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Check-out (YYYY-MM-DD):" minWidth="120"/>
        <TextField fx:id="checkOutField" prefWidth="250"/>
      </HBox>
      
      <Separator/>
      
      <Label fx:id="messageLabel" style="-fx-text-fill: blue;"/>
      
      <HBox spacing="10">
        <Button text="Create" onAction="#handleCreate" style="-fx-padding: 10; -fx-font-size: 14;"/>
        <Button text="Cancel" onAction="#handleCancel" style="-fx-padding: 10; -fx-font-size: 14;"/>
      </HBox>
    </VBox>
  </center>
</BorderPane>
