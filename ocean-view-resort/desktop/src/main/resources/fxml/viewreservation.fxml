<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.oceanview.desktop.controller.ViewReservationController">
  <center>
    <VBox spacing="15" style="-fx-padding: 25;">
      <Label text="View Reservation Details" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
      
      <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Reservation No:" minWidth="140"/>
        <TextField fx:id="reservationNoField" prefWidth="250" promptText="e.g., RES-2026-0001"/>
        <Button text="Search" onAction="#handleSearch" style="-fx-padding: 8;"/>
      </HBox>
      
      <Separator/>
      
      <Label fx:id="guestNameLabel" text="Guest: -"/>
      <Label fx:id="addressLabel" text="Address: -"/>
      <Label fx:id="contactLabel" text="Contact: -"/>
      <Label fx:id="roomTypeLabel" text="Room Type: -"/>
      <Label fx:id="checkInLabel" text="Check-in: -"/>
      <Label fx:id="checkOutLabel" text="Check-out: -"/>
      
      <Separator/>
      
      <Label fx:id="messageLabel" style="-fx-text-fill: blue;"/>
      
      <HBox spacing="10">
        <Button text="Cancel" onAction="#handleCancel" style="-fx-padding: 10; -fx-font-size: 14;"/>
      </HBox>
    </VBox>
  </center>
</BorderPane>
